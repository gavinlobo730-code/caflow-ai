# Backend environment. Every secret in the product belongs here — apps/web is a
# static export and cannot hold one (see apps/web/.env.local.example).
#
# render.yaml declares the production counterpart of this list, and
# tests/test_render_manifest_matches_code.py enforces it in both directions: a
# variable the code reads must be declared there (or exempted with a reason),
# and a variable declared there must actually be read by something. If you add a
# variable below, add it there too.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get from Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anon key — needed to build a per-user client (anon key + the caller's JWT) so
# Postgres RLS applies to the API path too. Without it the USE_USER_JWT path is
# dead and every query runs as service_role with RLS bypassed.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Note: JWT validation uses Supabase JWKS automatically — SUPABASE_JWT_SECRET
# is NOT required. The API fetches the public signing key from
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json at runtime.

# Run queries as `authenticated` (RLS enforced) rather than as service_role.
USE_USER_JWT=false

# ── Groq AI ───────────────────────────────────────────────────────────────────
# Get from https://console.groq.com — chat/text features and PDF invoice
# extraction (text-only model). Disabled if unset.
GROQ_API_KEY=gsk_...
# Optional override; defaults to llama-3.3-70b-versatile in code.
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Get from https://aistudio.google.com/api-keys — used ONLY for image-based
# invoice extraction (photographed/scanned bills). Groq's vision models were
# unavailable on this account; Gemini's free tier is genuinely free (no card
# on file) and multimodal-native.
GEMINI_API_KEY=AIza...
# Optional override; defaults to gemini-3.5-flash in code. Google retired
# gemini-2.5-flash ahead of its announced shutdown date — this variable is here
# so the next retirement is a config change, not a deploy.
# GEMINI_VISION_MODEL=gemini-3.5-flash

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Production example: https://caflow-ai.pages.dev,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# ── App Environment ───────────────────────────────────────────────────────────
# Set to "production" in production — disables the dev auth fallback (which
# accepts X-User-Role / X-Firm-Id headers in place of a real JWT).
APP_ENV=production

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Daily job sweep at 06:00 IST (recurring tasks, escalations, invoice lifecycle,
# compliance generation, collections, balance-cache audit, memory pipeline).
# Runs IN PROCESS via APScheduler — enable in exactly ONE process. With
# multi-worker gunicorn, leave false and drive it from an external cron instead.
ENABLE_SCHEDULER=false

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Get from https://resend.com — used for task, invoice, compliance, and
# engagement-letter ("Send to Client") emails.
# Leave blank to disable email delivery (notifications still created in DB).
# NOTE: engagement-letter sending requires this key — without it, "Send to
# Client" reports a delivery failure and the letter stays Generated.
RESEND_API_KEY=re_...
EMAIL_FROM=PracticeSync AI <noreply@caflow.ai>

# ── User-facing links ─────────────────────────────────────────────────────────
# FRONTEND_URL is the WEB app origin (not the API) and is the single source of
# every user-facing link the backend emits — team invitations, onboarding
# invites, and engagement-letter signing links ({FRONTEND_URL}/sign/?t=<token>).
# Everything derives from it via core/urls.py. If unset, the engagement email
# omits the "Review & Sign Online" button.
FRONTEND_URL=https://caflow-ai.pages.dev
# Client-portal origin. Defaults to FRONTEND_URL when unset; set it only if the
# portal is served from a different host.
# PORTAL_BASE_URL=

# ── Monitoring ────────────────────────────────────────────────────────────────
# Sentry is an ERROR-reporting install, not an APM one — traces default to 0 on
# purpose (the scheduler alone would exhaust the free-tier transaction quota,
# and an exhausted quota makes Sentry drop the errors it exists to capture).
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0

# ── Feature flags ─────────────────────────────────────────────────────────────
# Serve accrual reports from the reporting passbook (account_period_balances),
# with automatic fall-back to the legacy engine on any error.
REPORTING_PASSBOOK_MODE=on
MULTI_CURRENCY_ENABLED=false
# Require MFA (aal2) for the listed roles on destructive actions.
REQUIRE_MFA=false
# Comma-separated; defaults to Partner when unset.
# MFA_REQUIRED_ROLES=Partner

# ── Payments ──────────────────────────────────────────────────────────────────
# "mock" keeps the gateway inert and signs webhooks with MOCK_WEBHOOK_SECRET.
PAYMENT_PROVIDER=mock
# MOCK_WEBHOOK_SECRET=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
