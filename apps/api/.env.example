# ── Supabase ──────────────────────────────────────────────────────────────────
# Get from Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Note: JWT validation uses Supabase JWKS automatically — SUPABASE_JWT_SECRET
# is NOT required. The API fetches the public signing key from
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json at runtime.

# ── Groq AI ───────────────────────────────────────────────────────────────────
# Get from https://console.groq.com
GROQ_API_KEY=gsk_...

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Production example: https://caflow-ai.pages.dev,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# ── App Environment ───────────────────────────────────────────────────────────
# Set to "production" in production — disables dev auth fallback
APP_ENV=production

# ── Document Intelligence ─────────────────────────────────────────────────────
# mock = no real extraction; add providers later
DOCUMENT_INTELLIGENCE_PROVIDER=mock

# Daily automation scheduler (recurring tasks, escalations, invoice lifecycle).
# Enable in exactly ONE process. With multi-worker gunicorn, leave false and
# trigger POST /api/tasks/trigger-scheduler-run from an external cron instead.
ENABLE_SCHEDULER=false

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Get from https://resend.com — used for task, invoice, and compliance emails
# Leave blank to disable email delivery (notifications still created in DB)
RESEND_API_KEY=re_...
EMAIL_FROM=CAflow AI <noreply@caflow.ai>

# ── Frontend URL ──────────────────────────────────────────────────────────────
# Used for invite links in onboarding emails
FRONTEND_URL=https://caflow-ai.pages.dev
