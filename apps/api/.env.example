# ── Supabase ──────────────────────────────────────────────────────────────────
# Get from Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Get from Supabase Dashboard > Settings > API > JWT Settings
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ── Groq AI ───────────────────────────────────────────────────────────────────
# Get from https://console.groq.com
GROQ_API_KEY=gsk_...

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Production example: https://caflow-ai.pages.dev,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# ── App Environment ───────────────────────────────────────────────────────────
# Set to "production" in production — disables dev auth fallback
APP_ENV=production

# ── Document Intelligence ─────────────────────────────────────────────────────
# mock = no real extraction; add providers later
DOCUMENT_INTELLIGENCE_PROVIDER=mock
