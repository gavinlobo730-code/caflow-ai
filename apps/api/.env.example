# Supabase — get from your Supabase project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT secret — from Supabase project Settings > API > JWT Settings
SUPABASE_JWT_SECRET=your-jwt-secret

# Groq — from console.groq.com — used server-side only
GROQ_API_KEY=gsk_...

# Document extraction provider: mock | aws_textract | google_docai | azure_formrec
DOCUMENT_INTELLIGENCE_PROVIDER=mock
