{
  "_what_this_is": "The order a voucher's lines are shown in (ACC-16). The table apps/api/tests/test_a_voucher_shows_its_lines_in_order.py drives domain/accounting/line_order.py with. Kept as a fixture rather than inline cases because if a browser screen ever renders lines out of a direct PostgREST read it will need the same table — PostgREST cannot express 'debits before credits' as an ORDER BY. Nothing in apps/web reads it today, and the module's docstring says why.",
  "_the_rule": "line_order where the line has one; otherwise debits before credits, then created_at, then id.",
  "cases": [
    {
      "name": "line_order decides, whatever the amounts say",
      "rows": [
        {
          "id": "c",
          "line_order": 2,
          "debit_paise": 0,
          "credit_paise": 59000,
          "created_at": "2026-06-14T10:00:00Z"
        },
        {
          "id": "a",
          "line_order": 0,
          "debit_paise": 50000,
          "credit_paise": 0,
          "created_at": "2026-06-14T10:00:00Z"
        },
        {
          "id": "b",
          "line_order": 1,
          "debit_paise": 9000,
          "credit_paise": 0,
          "created_at": "2026-06-14T10:00:00Z"
        }
      ],
      "expected": [
        "a",
        "b",
        "c"
      ]
    },
    {
      "name": "a line_order of zero is an order, not an absence",
      "rows": [
        {
          "id": "credit",
          "line_order": 1,
          "debit_paise": 0,
          "credit_paise": 100,
          "created_at": "2026-06-14T10:00:00Z"
        },
        {
          "id": "debit",
          "line_order": 0,
          "debit_paise": 100,
          "credit_paise": 0,
          "created_at": "2026-06-14T10:00:00Z"
        }
      ],
      "expected": [
        "debit",
        "credit"
      ]
    },
    {
      "name": "an ordered voucher keeps a credit BEFORE a debit if that is how it was written",
      "rows": [
        {
          "id": "dr",
          "line_order": 1,
          "debit_paise": 100,
          "credit_paise": 0,
          "created_at": "2026-06-14T10:00:00Z"
        },
        {
          "id": "cr",
          "line_order": 0,
          "debit_paise": 0,
          "credit_paise": 100,
          "created_at": "2026-06-14T10:00:00Z"
        }
      ],
      "expected": [
        "cr",
        "dr"
      ]
    },
    {
      "name": "a pre-384 voucher shows debits before credits",
      "rows": [
        {
          "id": "cr1",
          "line_order": null,
          "debit_paise": 0,
          "credit_paise": 59000,
          "created_at": "2025-06-14T10:00:00Z"
        },
        {
          "id": "dr2",
          "line_order": null,
          "debit_paise": 9000,
          "credit_paise": 0,
          "created_at": "2025-06-14T10:00:00Z"
        },
        {
          "id": "dr1",
          "line_order": null,
          "debit_paise": 50000,
          "credit_paise": 0,
          "created_at": "2025-06-14T09:00:00Z"
        }
      ],
      "expected": [
        "dr1",
        "dr2",
        "cr1"
      ]
    },
    {
      "name": "created_at breaks the tie before id does",
      "rows": [
        {
          "id": "zzz",
          "line_order": null,
          "debit_paise": 100,
          "credit_paise": 0,
          "created_at": "2025-06-14T09:00:00Z"
        },
        {
          "id": "aaa",
          "line_order": null,
          "debit_paise": 100,
          "credit_paise": 0,
          "created_at": "2025-06-14T10:00:00Z"
        }
      ],
      "expected": [
        "zzz",
        "aaa"
      ]
    },
    {
      "name": "id is the last resort, so the order is TOTAL",
      "rows": [
        {
          "id": "b",
          "line_order": null,
          "debit_paise": 100,
          "credit_paise": 0,
          "created_at": "2025-06-14T09:00:00Z"
        },
        {
          "id": "a",
          "line_order": null,
          "debit_paise": 100,
          "credit_paise": 0,
          "created_at": "2025-06-14T09:00:00Z"
        }
      ],
      "expected": [
        "a",
        "b"
      ]
    },
    {
      "name": "a missing created_at does not raise",
      "rows": [
        {
          "id": "cr",
          "line_order": null,
          "debit_paise": 0,
          "credit_paise": 100
        },
        {
          "id": "dr",
          "line_order": null,
          "debit_paise": 100,
          "credit_paise": 0
        }
      ],
      "expected": [
        "dr",
        "cr"
      ]
    },
    {
      "name": "a zero-amount line reads as a credit, which is where the convention puts it",
      "rows": [
        {
          "id": "zero",
          "line_order": null,
          "debit_paise": 0,
          "credit_paise": 0,
          "created_at": "2025-06-14T08:00:00Z"
        },
        {
          "id": "dr",
          "line_order": null,
          "debit_paise": 100,
          "credit_paise": 0,
          "created_at": "2025-06-14T09:00:00Z"
        }
      ],
      "expected": [
        "dr",
        "zero"
      ]
    }
  ]
}
