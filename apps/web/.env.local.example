# apps/web is a STATIC EXPORT (`output: "export"` in next.config.mjs). It has no
# server, no route handlers, and no runtime environment. The only values it can
# read are NEXT_PUBLIC_* ones, and those are INLINED INTO THE BROWSER BUNDLE at
# build time.
#
# So: never put a secret in this file. Anything here is published. Every AI
# provider key, the Supabase service-role key, and every third-party secret
# belongs in apps/api/.env, where the FastAPI backend reads it.

# Supabase — get these from your Supabase project Settings > API.
# The anon key is designed to be public (RLS is what protects the data), which
# is why it is safe here and the service-role key is not.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# The FastAPI backend. In production this is set as a Cloudflare Pages build
# variable and in apps/web/wrangler.toml; next.config.mjs carries a matching
# production fallback so a missing value can never silently aim the app at
# localhost. Keep those two in step — scripts/api-url.test.ts fails if they
# disagree.
NEXT_PUBLIC_API_URL=http://localhost:8000
